{
  "name": "selene",
  "version": "1.7.1-dev.0",
  "description": "Local semantic code search, navigation, editing, and project memories.",
  "author": {
    "name": "Selene contributors"
  },
  "license": "MIT",
  "mcpServers": {
    "selene": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "--locked",
        "--no-dev",
        "--no-editable",
        "--no-env-file",
        "selene",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--enable-web-dashboard",
        "false",
        "--open-web-dashboard",
        "false",
        "--enable-gui-log-window",
        "false"
      ],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv"
      }
    }
  }
}
